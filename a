local function getLowPlayerServers(maxPlayersWanted)
    local servers = {}
    local cursor = ""
    repeat
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true%s",
            PlaceId,
            cursor ~= "" and "&cursor=" .. cursor or ""
        )
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)
        if not success then break end
        local body = HttpService:JSONDecode(response)
        for _, server in ipairs(body.data) do
            if server.id ~= JobId
                and server.playing
                and server.maxPlayers
                and server.playing <= maxPlayersWanted
                and server.playing < server.maxPlayers then
                table.insert(servers, server.id)
            end
        end
        cursor = body.nextPageCursor or ""
        if #servers > 0 then break end
        task.wait()
    until cursor == ""
    return servers
end

local function serverHop()
    notify("Server Hop", "Searching for servers with 10 players...")

    for attempt = 1, 10 do
        local servers = getLowPlayerServers(10)

        if #servers > 0 then
            if queue_on_teleport then
                local detect = getgenv().Detect
                local fling = getgenv().Fling

                queue_on_teleport(string.format([[
                    getgenv().Detect = %s
                    getgenv().Fling = %s

                    loadstring(game:HttpGet("https://raw.githubusercontent.com/nullsah/asdasadsad-dodoo/refs/heads/main/a"))()
                ]],tostring(detect), tostring(fling)))
            end

            notify("Server Hop", "Found " .. #servers .. " server(s)!")

            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                servers[math.random(#servers)],
                LocalPlayer
            )

            return
        end

        task.wait(0.5)
    end
end

local lastPositions = {}
local function checkCheaters()
    local coinContainer = getCoinContainer()
    if not coinContainer then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local currentPos = hrp.Position
                    local lastPos = lastPositions[player.UserId]
                    if lastPos then
                        local delta = (currentPos - lastPos).Magnitude
                        if delta > 60 then
                            for _, item in ipairs(coinContainer:GetChildren()) do
                                local targetPart = item:IsA("BasePart") and item
                                    or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
                                if targetPart and (currentPos - targetPart.Position).Magnitude < 5 then
                                    lastPositions[player.UserId] = currentPos
                                    return true
                                end
                            end
                        end
                    end
                    lastPositions[player.UserId] = currentPos
                end
            end
        end
    end
    return false
end

local function collectLoop()
    local lastCoin = nil
    while true do
        if detect then
            if checkCheaters() then
                notify("AC", "Exploiter detected, server hopping...")
                serverHop()
                break
            end
        end
        if not LocalPlayer:GetAttribute("Alive") then
            task.wait(0.05)
            continue
        end
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            task.wait(0.05)
            continue
        end
        local coinGui = LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container.Coin.Full
        if coinGui and coinGui.Visible then
            teleportToLobby()
            repeat
                task.wait(0.05)
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if not playerGui then break end
                local full = playerGui.MainGUI.Game.CoinBags.Container.Coin.Full
            until not full.Visible
        else
            local container = getCoinContainer()
            if container then
                local coins = {}
                for _, item in ipairs(container:GetChildren()) do
                    local targetPart
                    if item:IsA("BasePart") then
                        targetPart = item
                    elseif item:IsA("Model") then
                        targetPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                    end
                    if targetPart and targetPart.Parent and targetPart:FindFirstChildOfClass("TouchTransmitter") then
                        table.insert(coins, targetPart)
                    end
                end
                if #coins > 0 then
                    local character = LocalPlayer.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local currentPos = hrp.Position
                        local closestCoin = nil
                        local closestDist = math.huge
                        for _, coin in ipairs(coins) do
                            if coin ~= lastCoin then
                                local dist = (coin.Position - currentPos).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closestCoin = coin
                                end
                            end
                        end
                        if not closestCoin and lastCoin then
                            for _, coin in ipairs(coins) do
                                local dist = (coin.Position - currentPos).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closestCoin = coin
                                end
                            end
                        end
                        if closestCoin then
                            tweenToCoin(closestCoin)
                            lastCoin = closestCoin
                            task.wait()
                        end
                    end
                end
            end
        end
        task.wait(0.05)
    end
end
task.spawn(collectLoop)
