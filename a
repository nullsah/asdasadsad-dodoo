local function tweenToCoin(coinPart)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not coinPart or not coinPart.Parent then return end
    local currentPos = hrp.Position
    local targetPos = coinPart.Position
    local distance = (targetPos - currentPos).Magnitude
    local speed = 25
    local duration = math.max(distance / speed, 0.04)
    local targetCFrame = CFrame.new(targetPos)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    tween:Play()
    while tween.PlaybackState ~= Enum.PlaybackState.Completed do
        task.wait()
        if not coinPart.Parent then
            tween:Cancel()
            return
        end
    end
end

