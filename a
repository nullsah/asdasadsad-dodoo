local function playAnimation()
    if ActiveAnimTrack and ActiveAnimTrack.IsPlaying then
        ActiveAnimTrack:Stop()
    end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://91133306449431"
    local animTrack = animator:LoadAnimation(anim)
    animTrack.Priority = Enum.AnimationPriority.Movement
    animTrack:Play(0, 1, 0)
    anim:Destroy()
    task.defer(function()
        if animTrack and animTrack.IsPlaying then
            animTrack.TimePosition = 0.1275
            animTrack:AdjustSpeed(0)
        end
    end)
    ActiveAnimTrack = animTrack   
    return true
end

